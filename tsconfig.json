{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "allowUnusedLabels": false,
    "allowUnreachableCode": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "noUncheckedSideEffectImports": true,
    "erasableSyntaxOnly": true,
    // exactOptionalPropertyTypes stays off: libraries type optional props as
    // `prop?: string`, not `prop?: string | undefined`, so enabling it breaks call
    // sites with no real safety gain.
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    // The `node <file>.ts` entries in `package.json` run under bare Node, whose
    // ESM resolver needs the extension on every relative import.
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  // One type check covers both apps, so the generated route types of each are
  // named here: TypeScript's wildcards skip dot-prefixed directories, which is
  // where Next writes them.
  "include": [
    "sites/*/next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "sites/*/.next/types/**/*.ts",
    "sites/*/.next/dev/types/**/*.ts",
    "**/*.mts",
    "**/*.mjs",
    "**/*.cjs"
  ],
  // Each app's validator checks its layouts against a global `LayoutProps` its
  // own `routes.d.ts` declares, so in one program holding every app they read
  // one app's copy — and a nested layout in one fails against another's routes.
  // `next build` runs each validator against its own app, which is where it holds.
  "exclude": [
    "node_modules",
    "tmp",
    "sites/*/out",
    "sites/*/.next/types/validator.ts",
    "sites/*/.next/dev/types/validator.ts"
  ]
}
