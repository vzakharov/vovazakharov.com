# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js — each site builds into its own directory under sites/
.next/
out/

# Page PDFs are build artifacts: the deploy renders them into out/ after the
# build, and `pnpm content:pdf <site>` renders them locally. Their manifests are
# the render's own cache bookkeeping, so they are ignored alongside what they
# describe. .claude/rules/content.md carries the contract.
sites/*/public/**/*.pdf
sites/*/public/**/pdf-renders.json
# An authored PDF — something a document links to — lives under assets/ like
# every other asset, and is not a render. Left ignored it would be missing from
# the deploy with nothing to report it.
!sites/*/public/**/assets/**/*.pdf

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# python bytecode — scripts/lib is imported, so running any script writes here
__pycache__/

# typescript
*.tsbuildinfo
next-env.d.ts

# Scratch space for dev artifacts — one-off scripts, spikes, probe output,
# screenshots. Anything transient goes here rather than earning its own
# .gitignore entry. See CLAUDE.md "Dev artifacts go under tmp/".
tmp/

# Worktrees Claude Code creates for an isolated delegate. The path is the
# harness's, so it cannot move under tmp/; unignored, `git add -A` commits
# each one as a gitlink.
.claude/worktrees/

# python
__pycache__/
*.py[cod]
