# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js — each app builds into its own directory under apps/
.next/
out/

# Page PDFs are build artifacts: the deploy renders them into out/ after the
# build, and `pnpm content:pdf:<site>` renders them locally when you want to
# look at one. Their manifests are the render's cache bookkeeping, so they are
# ignored alongside what they describe. .claude/rules/content.md carries the
# contract.
apps/*/public/**/*.pdf
apps/*/public/**/pdf-renders.json
# An authored PDF — something a document links to — lives under assets/ like
# every other asset, and is not a render. Left ignored it would be missing from
# the deploy with nothing to report it.
!apps/*/public/**/assets/**/*.pdf

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# python bytecode — scripts/lib is imported, so running any script writes here
__pycache__/

# typescript
*.tsbuildinfo
next-env.d.ts

# Scratch space for dev artifacts — one-off scripts, spikes, probe output,
# screenshots. Anything transient goes here rather than earning its own
# .gitignore entry. See CLAUDE.md "Dev artifacts go under tmp/".
tmp/

# python
__pycache__/
*.py[cod]
