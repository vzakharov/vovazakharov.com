# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# python bytecode — scripts/lib is imported, so running any script writes here
__pycache__/

# typescript
*.tsbuildinfo
next-env.d.ts

# Scratch space for dev artifacts — one-off scripts, spikes, probe output,
# screenshots. Anything transient goes here rather than earning its own
# .gitignore entry. See CLAUDE.md "Dev artifacts go under tmp/".
tmp/

# python
__pycache__/
*.py[cod]
