{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["../../src/*"]
    }
  },
  // The two `../../` entries: `include` seeds the file set and imports extend
  // it, so an ambient declaration is in it only by being named here. Spelled
  // per app — each is its own `tsc` project, and `include` resolves against
  // the file stating it.
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "../../*.d.ts",
    "../../src/**/*.d.ts"
  ],
  "exclude": ["node_modules", "out"]
}
