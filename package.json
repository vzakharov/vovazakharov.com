{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:vova": "scripts/in-site.sh vova next dev",
    "dev:lsa": "scripts/in-site.sh lsa next dev",
    "dev:bible": "scripts/in-site.sh bible next dev",
    "dev:basilisk": "scripts/in-site.sh basilisk next dev",
    "dev:maya": "scripts/in-site.sh maya next dev",
    "build": "pnpm build:vova && pnpm build:lsa && pnpm build:bible && pnpm build:basilisk && pnpm build:maya",
    "build:vova": "scripts/in-site.sh vova next build",
    "play:mushrooms": "tsx scripts/play-mushrooms.ts",
    "sweep:mushrooms": "tsx scripts/sweep-mushrooms.ts",
    "build:lsa": "scripts/in-site.sh lsa next build",
    "build:bible": "scripts/in-site.sh bible next build",
    "build:basilisk": "scripts/in-site.sh basilisk next build",
    "build:maya": "scripts/in-site.sh maya next build",
    "typegen": "for site in vova lsa bible basilisk maya; do scripts/in-site.sh $site next typegen || exit 1; done",
    "typecheck": "tsc --noEmit",
    "test": "scripts/test-changed.sh",
    "test:all": "scripts/vet-test.sh",
    "test:meadow": "node --import tsx --test \"src/pages/mushrooms/**/*.test.ts\"",
    "type-overlap": "tsx scripts/type-overlap-check.ts",
    "knip": "knip",
    "check:mantine-styles": "node scripts/check-mantine-styles.ts",
    "check:i18n-payload": "node scripts/check-i18n-payload.ts",
    "check:typography": "node scripts/check-typography.ts",
    "check:masked-words": "node scripts/check-masked-words.ts",
    "check:song-titles": "node scripts/check-song-titles.ts",
    "check:stanza-repeats": "node scripts/check-stanza-repeats.ts",
    "lint": "pnpm lint:check --fix",
    "lint:check": "pnpm lint:files .",
    "lint:files": "NODE_OPTIONS=\"$NODE_OPTIONS --max-old-space-size=3072\" eslint --no-warn-ignored",
    "lint:css": "stylelint \"**/*.{css,scss}\"",
    "lint:fsd": "steiger src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "content:mermaid": "scripts/in-site.sh vova node scripts/render-mermaid.ts",
    "content:drawings:maya": "scripts/in-site.sh maya node scripts/translate-drawings.ts",
    "translation:stamp": "node scripts/stamp-translation.ts",
    "content:og:vova": "scripts/in-site.sh vova tsx --conditions=react-server scripts/render-og.ts",
    "content:og:bible": "scripts/in-site.sh bible tsx --conditions=react-server scripts/render-og.ts",
    "content:og:basilisk": "scripts/in-site.sh basilisk tsx --conditions=react-server scripts/render-og.ts",
    "content:og:maya": "scripts/in-site.sh maya tsx --conditions=react-server scripts/render-og.ts",
    "basilisk:reflections": "scripts/in-site.sh basilisk tsx --conditions=react-server scripts/pick-reflections.ts",
    "content:pdf:vova": "scripts/in-site.sh vova tsx scripts/render-pdf.ts",
    "content:pdf:bible": "scripts/in-site.sh bible tsx scripts/render-pdf.ts",
    "content:pdf:basilisk": "scripts/in-site.sh basilisk tsx scripts/render-pdf.ts",
    "music:scaffold": "scripts/in-site.sh vova tsx scripts/scaffold-song.ts",
    "music:masters": "scripts/in-site.sh vova tsx --conditions=react-server scripts/masters.ts",
    "music:untold": "node scripts/list-untold-songs.ts",
    "random-words": "node personas/tools/random-words.ts",
    "whisper-lexicon": "node personas/tools/whisper-lexicon.ts",
    "styles:codegen": "node scripts/generate-styles.ts",
    "costs": "python3 .claude/costs/report.py",
    "artifact:mushrooms": "tsx scripts/build-mushroom-artifact.ts"
  },
  "dependencies": {
    "@mantine/core": "^9.6.0",
    "@mantine/hooks": "^9.6.0",
    "@shikijs/rehype": "^4.4.3",
    "gray-matter": "^4.0.3",
    "hast-util-to-html": "9.0.5",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "lucide-react": "^0.554.0",
    "next": "16.0.3",
    "next-intl": "^4.5.4",
    "phaser": "^4.2.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "server-only": "^0.0.1",
    "shiki": "^4.4.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.18.6",
    "@faker-js/faker": "10.6.0",
    "@feature-sliced/steiger-plugin": "^0.7.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/merriweather": "5.3.0",
    "@steiger/toolkit": "0.2.3",
    "@types/estree": "^1.0.9",
    "@types/estree-jsx": "^1.0.5",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/unist": "^3.0.3",
    "@typescript-eslint/parser": "^8.69.0",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unicorn": "^63.0.0",
    "jiti": "^2.7.0",
    "knip": "^6.38.0",
    "mdast-util-directive": "^3.1.0",
    "node-taglib-sharp": "^6.0.3",
    "prettier": "^3.6.2",
    "sass": "^1.103.1",
    "steiger": "^0.6.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
