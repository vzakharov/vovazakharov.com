+/**
+ * A tile varying sampled at the centroid of the covered MSAA samples, never
+ * extrapolated past its triangle: a skirt taking one sample at a tile's edge
+ * shades a whole pixel, and at the pixel centre its height and normal would
+ * lie outside the thin skirt and off its border's colour.
+ */
+const centroid = <T extends string>(node: Node<T>, name: string) =>
+  varying(node, name).setInterpolation(
+    InterpolationSamplingType.PERSPECTIVE,
+    InterpolationSamplingMode.CENTROID,
+  );
+
+const heightNode = () =>
+  centroid(attribute(HEIGHT_ATTRIBUTE, 'float'), 'v_tileHeight');
+
+/** The tile's view-space normal, interpolated at the centroid. */
+const normalNode = () =>
+  centroid(transformNormalToView(normalLocal), 'v_tileNormal').normalize();
+
+const depthNode = () =>
+  viewZToLogarithmicDepth(
+    centroid(positionView.z, 'v_tileViewZ'),
+    cameraNear,
+    cameraFar,
+  );
 
