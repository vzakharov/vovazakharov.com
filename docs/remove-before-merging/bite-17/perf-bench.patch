+// TEMPORARY dusk frame-cost bench, never committed.
+import fs from 'node:fs';
+import { z } from 'zod';
+
+import { DUSK_MS } from '../../src/pages/mushrooms/model/dusk.ts';
+import {
+  type Controls,
+  Point,
+  State,
+  SunAt,
+} from './mushroom-probe-answers.ts';
+import { type Expect, FRAME_MS, inTurn, type Page } from './mushroom-probe-drive.ts';
+
+const S = 'window.__game.scene.scenes[0]';
+const N = Number(process.env['BENCH_N'] ?? 40);
+
+async function furnish(page: Page, controls: z.infer<typeof Controls>) {
+  const pick = async (at: z.infer<typeof Point>) => {
+    await page.tap(at);
+    await page.step(6);
+  };
+  await page.tap(controls.house);
+  await page.step(30);
+  await inTurn(controls.housePicker, pick);
+  const { mushrooms } = await page.evaluate('__probe.state()', State);
+  const older = mushrooms.at(-2);
+  const at =
+    older === undefined
+      ? null
+      : await page.evaluate(`__probe.mushroom(${JSON.stringify(older)})`, Point.nullable());
+  if (at) {
+    await pick(at);
+    await inTurn(controls.housePicker, pick);
+  }
+  await pick(controls.house);
+  await page.evaluate("__probe.scene.dispatch({ kind: 'deselect' })", z.unknown());
+  await page.step(45);
+}
+
+async function measure(page: Page, label: string, note: (l: string) => void) {
+  const js: number[] = [];
+  const per = new Map<string, number[]>();
+  for (let i = 0; i < N; i += 1) {
+    await page.evaluate('(() => { window.__acc = {}; window.__gl = { draws: 0, verts: 0, fbs: 0, clears: 0 }; return true; })()', z.boolean());
+    const before = page.rendered.length;
+    await page.step(1);
+    js.push(page.rendered[before] ?? Number.NaN);
+    if (i === N - 1) per.set('gl ' + await page.evaluate('JSON.stringify(window.__gl)', z.string()), [0]);
+    const acc = await page.evaluate('window.__acc', z.record(z.string(), z.number()));
+    for (const [k, v] of Object.entries(acc)) per.set(k, [...(per.get(k) ?? []), v]);
+  }
+  const med = (v: number[]) => [...v, ...Array<number>(Math.max(0, N - v.length)).fill(0)].toSorted((a, b) => a - b)[Math.floor(N / 2)] ?? Number.NaN;
+  const parts = [...per].map(([k, v]) => `${k} ${med(v).toFixed(2)}`).join(', ');
+  const line = `${label.padEnd(28)} frame ${med(js).toFixed(1)} ms | median: ${parts}`;
+  note(line);
+  fs.appendFileSync(process.env['BENCH_OUT'] ?? '/dev/null', `${line}\n`);
+}
+
+const Node = z.object({ id: z.number(), callFrame: z.object({ functionName: z.string(), url: z.string(), lineNumber: z.number() }), children: z.array(z.number()).optional() });
+const Profile = z.object({ profile: z.object({ nodes: z.array(Node), samples: z.array(z.number()), timeDeltas: z.array(z.number()) }) });
+async function profile(page: Page, label: string, note: (l: string) => void) {
+  const send = (page as unknown as { send: (m: string, p?: object) => Promise<unknown> }).send;
+  await send('Profiler.enable');
+  await send('Profiler.setSamplingInterval', { interval: 200 });
+  await send('Profiler.start');
+  const frames = 60;
+  for (let i = 0; i < frames; i += 1) await page.step(1);
+  const { profile: p } = Profile.parse(await send('Profiler.stop'));
+  const byId = new Map(p.nodes.map((n) => [n.id, n]));
+  const parent = new Map<number, number>();
+  for (const n of p.nodes) for (const c of n.children ?? []) parent.set(c, n.id);
+  const self = new Map<string, number>();
+  const total = new Map<string, number>();
+  let all = 0;
+  for (const [i, id] of p.samples.entries()) {
+    const dt = (p.timeDeltas[i] ?? 0) / 1000;
+    const n = byId.get(id);
+    if (!n) continue;
+    const key = (m: z.infer<typeof Node>) => `${m.callFrame.functionName || '(anon)'}@${m.callFrame.url.split('/').pop() ?? ''}:${String(m.callFrame.lineNumber)}`;
+    if (['(idle)', '(program)', '(garbage collector)'].includes(n.callFrame.functionName) || n.callFrame.functionName === '(root)') { self.set(n.callFrame.functionName, (self.get(n.callFrame.functionName) ?? 0) + dt); continue; }
+    all += dt;
+    self.set(key(n), (self.get(key(n)) ?? 0) + dt);
+    const seen = new Set<string>();
+    for (let at: number | undefined = id; at !== undefined; at = parent.get(at)) { const m = byId.get(at); if (!m) break; const k = key(m); if (seen.has(k)) continue; seen.add(k); total.set(k, (total.get(k) ?? 0) + dt); }
+  }
+  const top = (m: Map<string, number>, n: number) => [...m].toSorted((a, b) => b[1] - a[1]).slice(0, n).map(([k, v]) => `  ${(v / frames).toFixed(2)} ms/frame ${k}`).join('\n');
+  const text = `PROFILE ${label}: JS ${(all / frames).toFixed(2)} ms/frame\n self:\n${top(self, 25)}\n total:\n${top(total, 45)}\n`;
+  note(text);
+  fs.appendFileSync(process.env['BENCH_OUT'] ?? '/dev/null', text);
+}
+
+const PIECES: Array<[string, string]> = [
+  ['fireflies', 'S.dusk.fireflies.shown.map((s) => s.container)'],
+  ['moon', '[S.dusk.moon]'],
+  ['wash', '[S.dusk.wash]'],
+  ['stars', 'S.backdrop.stars'],
+  ['duskClouds', 'S.backdrop.duskClouds'],
+  ['duskBake', '[...S.backdrop.duskSky, ...S.backdrop.duskGround]'],
+  ['house.glow', '[...S.bed.shown.values()].flatMap((s) => s.house ? [s.house.glow] : [])'],
+];
+
+async function ab(page: Page, piece: string, note: (l: string) => void) {
+  const on: number[] = [];
+  const off: number[] = [];
+  const counts: string[] = [];
+  for (let i = 0; i < N; i += 1) {
+    for (const [gone, into] of [[true, off], [false, on]] as const) {
+      await page.evaluate(`(() => { window.__off = { [${JSON.stringify(piece)}]: ${String(gone)} }; return true; })()`, z.boolean());
+      await page.evaluate('(() => { window.__gl = { draws: 0, verts: 0, fbs: 0, clears: 0 }; return true; })()', z.boolean());
+      const before = page.rendered.length;
+      await page.step(1);
+      into.push(page.rendered[before] ?? Number.NaN);
+      const c = await page.evaluate('JSON.stringify(window.__gl)', z.string());
+      if (i === 0) counts.push(`${gone ? 'off' : 'on'} ${c}`);
+    }
+  }
+  const med = (v: number[]) => v.toSorted((a, b) => a - b)[Math.floor(v.length / 2)] ?? Number.NaN;
+  const line = `A/B ${piece.padEnd(12)} on ${med(on).toFixed(1)} off ${med(off).toFixed(1)} saves ${(med(on) - med(off)).toFixed(1)} ms | ${counts.join(' ')}`;
+  note(line);
+  fs.appendFileSync(process.env['BENCH_OUT'] ?? '/dev/null', `${line}\n`);
+}
+
+export async function playBench(
+  page: Page,
+  controls: z.infer<typeof Controls>,
+  _expect: Expect,
+  note: (line: string) => void,
+): Promise<void> {
+  await furnish(page, controls);
+  await page.evaluate(`(() => {
+    const S = ${S};
+    const wrap = (o, k, name) => { const f = o[k].bind(o); o[k] = (...a) => { if (o.__w) return f(...a); const s = performance.now(); const r = f(...a); window.__acc = window.__acc ?? {}; window.__acc[name] = (window.__acc[name] ?? 0) + performance.now() - s; return r; }; };
+    wrap(S, 'update', 'update');
+    wrap(S.dusk, 'update', 'dusk.update');
+    wrap(S.dusk.fireflies, 'update', 'fireflies');
+    wrap(S.backdrop, 'relight', 'relight');
+    wrap(S.bed, 'update', 'bed.update');
+    for (const s of S.bed.shown.values()) if (s.house) wrap(s.house, 'light', 'house.light');
+    const gl = window.__game.renderer.gl;
+    window.__gl = { draws: 0, verts: 0, fbs: 0, clears: 0 };
+    for (const k of ['drawElements', 'drawArrays', 'drawElementsInstanced', 'drawArraysInstanced']) { const f = gl[k].bind(gl); gl[k] = (...a) => { window.__gl.draws += 1; window.__gl.verts += (k.startsWith('drawElements') ? a[1] : a[2]); return f(...a); }; }
+    { const f = gl.bindFramebuffer.bind(gl); gl.bindFramebuffer = (...a) => { window.__gl.fbs += 1; return f(...a); }; }
+    { const f = gl.clear.bind(gl); gl.clear = (...a) => { window.__gl.clears += 1; return f(...a); }; }
+    const g = window.__game; wrap(g.scene, 'render', 'render'); wrap(g.renderer, 'postRender', 'postRender');
+    return true;
+  })()`, z.boolean());
+  await page.step(30);
+  await profile(page, 'day', note);
+  await measure(page, 'day', note);
+  await page.shoot('bench-day');
+  const sun = await page.evaluate('__probe.sunAt()', SunAt);
+  if (!sun) throw new Error('no sun');
+  await page.tap(sun);
+  await page.step(Math.round(DUSK_MS / FRAME_MS) + 30);
+  await page.shoot('bench-dusk');
+  await page.evaluate(`(() => {
+    const S = ${S};
+    const names = new Map();
+    const name = (o, n) => { if (o) names.set(o, n); };
+    for (const s of S.dusk.fireflies.shown) { name(s.halo, 'ff.halo'); name(s.body, 'ff.body'); name(s.tail, 'ff.tail'); name(s.container, 'ff.container'); }
+    for (const s of S.bed.shown.values()) { if (s.house) name(s.house.glow, 'house.glow'); }
+    for (const o of S.backdrop.stars) name(o, 'stars');
+    for (const o of S.backdrop.duskClouds) name(o, 'duskClouds');
+    for (const o of S.backdrop.rainClouds) name(o, 'rainClouds');
+    for (const o of S.backdrop.clouds) name(o, 'clouds');
+    for (const o of [...S.backdrop.duskSky, ...S.backdrop.duskGround]) name(o, 'duskBake');
+    name(S.dusk.moon, 'moon'); name(S.dusk.wash, 'wash');
+    name(S.backdrop.hills.far, 'hills'); name(S.backdrop.hills.near, 'hills'); name(S.backdrop.brow, 'brow');
+    const seen = new Set();
+    const wrapAll = (list) => { for (const o of list) { if (seen.has(o)) continue; seen.add(o);
+      const n = names.get(o) ?? ('t:' + o.type);
+      const f = o.renderWebGLStep.bind(o);
+      o.renderWebGLStep = (...a) => { if (a[4]) return f(...a); if (window.__in) return f(...a); window.__in = true; const s = performance.now(); try { return f(...a); } finally { window.__in = false; window.__acc[n] = (window.__acc[n] ?? 0) + performance.now() - s; } };
+      if (o.list && o.type === 'Container') wrapAll(o.list);
+    } };
+    wrapAll(S.children.list);
+    return true;
+  })()`, z.boolean());
+  await profile(page, 'dusk', note);
+  await measure(page, 'dusk (all on)', note);
+  await page.evaluate(`(() => { const S = ${S};
+    const gate = (piece, list) => { for (const o of list) { const w = o.willRender.bind(o); o.willRender = (c) => !(window.__off?.[piece] || window.__off?.all) && w(c); } };
+    ${PIECES.map(([p, list]) => `gate(${JSON.stringify(p)}, ${list});`).join('\n')}
+    return true; })()`, z.boolean());
+  if (!process.env['BENCH_NOAB']) for (const [piece] of [...PIECES, ['all']]) await ab(page, piece, note);
+  await page.shoot('bench-dusk-off');
+  note(await page.evaluate(`(() => { const S = ${S}; window.__acc = {}; const T = S.clock * 1000 + 16.67; const a = performance.now(); window.__game.step(T, 16.67); const b = performance.now(); return JSON.stringify({ step: b - a, acc: window.__acc }); })()`, z.string()));
+}
