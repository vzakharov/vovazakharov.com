+/**
+ * A visit's perches as `Aloft`s: every cap's and standing flower's seat and
+ * every spot in the air, from the real `perchSight` and `footRows`, stood on
+ * the plane by `ofLayout`'s own construction.
+ */
+
+import { spread } from '../../../../src/pages/mushrooms/model/ground';
+import type { MeadowLayout } from '../../../../src/pages/mushrooms/ui/scene/layout';
+import { clumpRow, footRows, perchSight } from '../../../../src/pages/mushrooms/ui/scene/perch-sight';
+import { middleOf, rowAt } from '../../../../src/pages/mushrooms/ui/scene/view';
+import { opened } from '../../../../src/pages/mushrooms/ui/scene/visit-play';
+import type { Aloft } from './proto';
+
+/** A perch on the plane: its name, whether it is a seat, and where. */
+export type PlanePerch = { name: string; seat: boolean; at: Aloft };
+
+/** The visit `seed`'s forest on a `width` × `height` screen, and its perches on the plane. */
+export function perchesOf(
+  seed: number,
+  width: number,
+  height: number,
+): { layout: MeadowLayout; perches: PlanePerch[] } {
+  const stand = opened(seed, width, height, true);
+  const { layout } = stand;
+  const places = perchSight(stand).places ?? {};
+  const rows = footRows(stand);
+  const clump = clumpRow(layout);
+  const perches = Object.entries(places).flatMap(([name, place]) => {
+    if (name.startsWith('away')) return [];
+    const row = rows.get(name) ?? clump;
+    const [x, y] = [place.x * layout.insectSize, place.y * layout.insectSize];
+    const { opening, perPx } = rowAt(layout.camera, row);
+    const plane = spread({ x: (x - middleOf(layout.camera)) * perPx, y: opening });
+    return [{ name, seat: !name.startsWith('air'), at: { ...plane, h: (row - y) * perPx } }];
+  });
+  return { layout, perches };
+}
