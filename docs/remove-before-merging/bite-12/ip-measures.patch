index 00000000..18674c2f
--- /dev/null
+++ b/docs/remove-before-merging/bite-12/ip3/legs.ts
@@ -0,0 +1,141 @@
+/**
+ * One leg flown in the leg's frame with the real `steer`, 60 fps, and drawn
+ * through `drawnAloft` with each veer the round tries, frame by frame.
+ */
+
+import type { Point } from '../../../../src/pages/mushrooms/model/geometry';
+import {
+  type Camera,
+  CLUMP_DISTANCE,
+  type Eye,
+} from '../../../../src/pages/mushrooms/model/ground';
+import type { InsectKind } from '../../../../src/pages/mushrooms/model/insect-genes';
+import { firstSteering, steer } from '../../../../src/pages/mushrooms/model/insect-steering';
+import { smooth } from '../../../../src/pages/mushrooms/model/motion';
+import { onScreen, V_NEAR, viewAt } from '../../../../src/pages/mushrooms/ui/scene/view';
+import {
+  type Aloft,
+  aloftOf,
+  alongOf,
+  centreOf,
+  drawnAloft,
+  framedOf,
+  mixQ,
+  type Veer,
+  veerAloft,
+} from './proto';
+
+/** Each kind's cruise, in butterfly sizes a second (the plan's starting values). */
+export const CRUISE = { butterfly: 1, fly: 7, bee: 4.6 } as const satisfies Record<InsectKind, number>;
+/** Each kind's widest span, in its own size (`perch-sight.ts` `WIDEST_SPANS`). */
+export const SPANS = { butterfly: 1.22, fly: 1.36, bee: 1.2 } as const satisfies Record<InsectKind, number>;
+
+const FLUTTER = 0.28;
+const FRAME = 1000 / 60;
+/** How long a leg's end is held after it arrives, in ms. */
+const HOLD = 500;
+/** The share of a leg's way the veer fades in over off a seat inside it. */
+export const FADE = 0.3;
+
+/** What a leg is flown between: its ends, whether each is a seat (a host that hides its sitter when culled), and the eye frame by frame. */
+export type Leg = {
+  camera: Camera;
+  kind: InsectKind;
+  /** Its size in CSS px at `CLUMP_DISTANCE` (`insectSizes`), and the butterfly's. */
+  size: number;
+  butterfly: number;
+  phase: number;
+  start: Aloft;
+  end: Aloft;
+  startSeat: boolean;
+  endSeat: boolean;
+  eye: (now: number) => Eye;
+  /** Ms flown, by default its length at its cruise. */
+  time?: number;
+};
+
+/** One frame of a leg, drawn one way. */
+export type Drawn = { shown: boolean; zoom: number; px: number; x: number; y: number; d: number; popped?: boolean };
+
+/** The veer a variant draws through, or none. */
+export type Variant = { name: string; veer?: (camera: Camera) => Veer };
+
+/** A seat end's share inside the veer, 0 outside `r + w` to 1 inside `r`. */
+function inside(d: number, { r, w }: Veer): number {
+  return Math.min(1, Math.max(0, (r + w - d) / w));
+}
+
+/** The leg's time in ms: its length in its set-off frame, in butterfly sizes as drawn, at its kind's cruise. */
+export function legTime(leg: Leg, c: number): number {
+  const eye = leg.eye(0);
+  const [a, b] = [framedOf(leg.camera, eye, c, leg.start), framedOf(leg.camera, eye, c, leg.end)];
+  const px = Math.hypot(b.x - a.x, b.y - a.y);
+  const mean = Math.abs(a.q - b.q) < 1e-9 ? a.q : (a.q - b.q) / Math.log(a.q / b.q);
+  const sizes = (px / leg.butterfly) * (mean / CLUMP_DISTANCE);
+  return Math.max(300, (1000 * sizes) / CRUISE[leg.kind]);
+}
+
+/** Flies `leg`, drawing each frame through every variant. */
+export function fly(leg: Leg, variants: readonly Variant[]): { time: number; frames: Drawn[][] } {
+  const { camera, kind, size, phase, start, end } = leg;
+  const c = centreOf(leg.eye(0), start, end);
+  const time = leg.time ?? legTime(leg, c);
+  let steering = firstSteering({ facing: 0, turn: 0 });
+  let flown = 0;
+  let aim: Point | undefined;
+  const frames: Drawn[][] = variants.map(() => []);
+  const span = SPANS[kind] * size;
+  for (let now = 0; now <= time + HOLD; now += FRAME) {
+    const eye = leg.eye(now);
+    const view = viewAt(camera, eye);
+    const [s, e] = [framedOf(camera, eye, c, start), framedOf(camera, eye, c, end)];
+    aim ??= e;
+    const zoomed = (size * CLUMP_DISTANCE) / mixQ(s.q, e.q, flown);
+    const out = steer(
+      steering,
+      {
+        leg: { departs: 0, arrives: time },
+        carried: { launch: leg.startSeat ? 0 : 1, speed: 0, drink: 0 },
+        start: s,
+        end: e,
+        aim,
+        sat: leg.startSeat ? 0 : undefined,
+        perched: leg.endSeat,
+        size: zoomed,
+        motion: { kind, phase, flutter: zoomed * FLUTTER },
+      },
+      now,
+    );
+    steering = out.steering;
+    flown = now >= time ? 1 : alongOf(out.point, s, e);
+    const raw = aloftOf(camera, eye, c, out.point, mixQ(s.q, e.q, flown));
+    const ds = Math.hypot(start.x - eye.x, start.y - eye.y);
+    const de = Math.hypot(end.x - eye.x, end.y - eye.y);
+    // A seat whose host the meadow culls hides its sitter (`cull`, at the host's drawn distance).
+    const sittingHidden =
+      (flown >= 1 && leg.endSeat && (drawnAloft(view, end)?.zoom ?? Infinity) > CLUMP_DISTANCE / V_NEAR) ||
+      (flown <= 0 && leg.startSeat && (drawnAloft(view, start)?.zoom ?? Infinity) > CLUMP_DISTANCE / V_NEAR);
+    variants.forEach((variant, index) => {
+      let aloft = raw;
+      if (variant.veer) {
+        const veer = variant.veer(camera);
+        const s0 = leg.startSeat ? inside(ds, veer) : 0;
+        const s1 = leg.endSeat ? inside(de, veer) : 0;
+        const keep = (1 - s0 * (1 - smooth(flown / FADE))) * (1 - s1 * (1 - smooth((1 - flown) / FADE)));
+        aloft = veerAloft(eye, raw, veer, keep);
+      }
+      const drawn = sittingHidden ? undefined : drawnAloft(view, aloft);
+      const shown = drawn !== undefined && onScreen(view, drawn, -span * drawn.zoom);
+      frames[index]?.push({
+        shown,
+        popped: sittingHidden,
+        zoom: drawn?.zoom ?? 0,
+        px: span * (drawn?.zoom ?? 0),
+        x: drawn?.x ?? Number.NaN,
+        y: drawn?.y ?? Number.NaN,
+        d: Math.hypot(aloft.x - eye.x, aloft.y - eye.y),
+      });
+    });
+  }
+  return { time, frames };
+}
diff --git a/docs/remove-before-merging/bite-12/ip3/proto.ts b/docs/remove-before-merging/bite-12/ip3/proto.ts
