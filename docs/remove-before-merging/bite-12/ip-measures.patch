index 00000000..2188b241
--- /dev/null
+++ b/docs/remove-before-merging/bite-12/ip3/bench.ts
@@ -0,0 +1,62 @@
+/**
+ * R3.2: what drawing one flying insect costs a frame, today's `drawnInsect`
+ * (mid-leg, a host at either end) against the leg's frame path (both ends
+ * framed, the point back to an `Aloft`, the veer, `drawnAloft`). `steer` is
+ * the same on both and left out. `node --import tsx bench.ts`.
+ */
+
+import { CLUMP_DISTANCE, type Ground, project } from '../../../../src/pages/mushrooms/model/ground';
+import { bedPlace, type Host } from '../../../../src/pages/mushrooms/ui/scene/bed-place';
+import { drawnInsect } from '../../../../src/pages/mushrooms/ui/scene/insect-seat';
+import { meadowCamera } from '../../../../src/pages/mushrooms/ui/scene/meadow-camera';
+import { type View, viewAt } from '../../../../src/pages/mushrooms/ui/scene/view';
+import { aloftOf, alongOf, centreOf, drawnAloft, framedOf, mixQ, radiusOn, veerAloft } from './proto';
+
+const camera = meadowCamera(1180, 820);
+const eye = { x: 0.4, y: 1.1, heading: 0.3 };
+const view = viewAt(camera, eye);
+
+function hostOn(on: View, foot: Ground): Host {
+  const { x, y } = project(on, foot);
+  return { laidFoot: { x, y }, stands: bedPlace(on, foot) };
+}
+
+const seats = { left: hostOn(view, { x: -0.4, z: 0.1 }), to: hostOn(view, { x: 0.9, z: 0.7 }) };
+const points = Array.from({ length: 64 }, (_, index) => ({ x: 300 + index * 9, y: 380 + (index % 7) * 11 }));
+const start = { x: -2, y: 9, h: 0.9 };
+const end = { x: 3, y: 12, h: 1.1 };
+const veer = { r: radiusOn(camera, true), w: 0.1 * CLUMP_DISTANCE };
+const c = centreOf(eye, start, end);
+
+const RUNS = 400_000;
+let sink = 0;
+
+function time(name: string, each: (index: number) => number): number {
+  for (let index = 0; index < RUNS / 10; index++) sink += each(index);
+  const rounds: number[] = [];
+  for (let round = 0; round < 5; round++) {
+    const begun = performance.now();
+    for (let index = 0; index < RUNS; index++) sink += each(index);
+    rounds.push(((performance.now() - begun) * 1000) / RUNS);
+  }
+  const best = Math.min(...rounds);
+  console.log(`${name.padEnd(34)} ${best.toFixed(3)} µs per insect, ${(best * 30).toFixed(1)} µs for 30`);
+  return best;
+}
+
+time('today: drawnInsect, two hosts', (index) => {
+  const point = points[index % points.length] ?? { x: 0, y: 0 };
+  return drawnInsect(view, point, { flown: 0.4, row: 560 }, seats)?.zoom ?? 0;
+});
+time('today: drawnInsect, no host', (index) => {
+  const point = points[index % points.length] ?? { x: 0, y: 0 };
+  return drawnInsect(view, point, { flown: 0.4, row: 560 }, {})?.zoom ?? 0;
+});
+time('frame: frame ends, back, veer, draw', (index) => {
+  const point = points[index % points.length] ?? { x: 0, y: 0 };
+  const [s, e] = [framedOf(camera, eye, c, start), framedOf(camera, eye, c, end)];
+  const flown = alongOf(point, s, e);
+  const aloft = veerAloft(eye, aloftOf(camera, eye, c, point, mixQ(s.q, e.q, flown)), veer);
+  return drawnAloft(view, aloft)?.zoom ?? 0;
+});
+console.log(sink > 0 ? '' : '-');
diff --git a/docs/remove-before-merging/bite-12/ip3/legs.ts b/docs/remove-before-merging/bite-12/ip3/legs.ts
