index 00000000..41a0e375
--- /dev/null
+++ b/docs/remove-before-merging/bite-12/ip3/back.ts
@@ -0,0 +1,75 @@
+/**
+ * R3.1's look back: a release's bowed (steered) leg, in the leg's frame, with
+ * the eye looking back — from beyond the forest at the clump, and from the
+ * opening eye at a perch stood behind it — start → each perch the screen
+ * shows, and start → out past the side. Share of frames drawn, per screen.
+ * `node --import tsx back.ts`.
+ */
+
+import { alongSight, CLUMP_DISTANCE, EYE_HEIGHT, type Eye, pinholeOf } from '../../../../src/pages/mushrooms/model/ground';
+import { INSECT_KINDS } from '../../../../src/pages/mushrooms/model/insect-genes';
+import { bendAt } from '../../../../src/pages/mushrooms/model/ground';
+import { awayDown, PAST_BROW } from '../../../../src/pages/mushrooms/ui/scene/insect-away';
+import { D_SEE, onScreen, viewAt } from '../../../../src/pages/mushrooms/ui/scene/view';
+import { VIEWPORTS } from '../../../../src/pages/mushrooms/ui/scene/viewports';
+import { fly, SPANS } from './legs';
+import { type Aloft, drawnAloft, radiusOn } from './proto';
+import { perchesOf } from './world';
+
+const OUT_AHEAD = 0.5;
+
+for (const [screen, width, height] of VIEWPORTS) {
+  const { layout, perches } = perchesOf(1, width, height);
+  const camera = layout.camera;
+  const pin = pinholeOf(camera);
+  const shares: number[] = [];
+  let [legs, full, landed] = [0, 0, 0];
+  const at = (eye: Eye, x: number, d: number, y: number): Aloft => {
+    const plane = alongSight(camera, eye, x, d);
+    return { ...plane, h: EYE_HEIGHT - ((y - pin.y) * d) / (pin.focal * bendAt(pin, x)) };
+  };
+  const eyes: Array<{ eye: Eye; behind?: Aloft[] }> = [Math.PI, Math.PI - 0.035, Math.PI + 0.035].flatMap((heading) => {
+    const opening = { x: 0, y: 0, heading };
+    return [
+      { eye: { x: 0, y: 18, heading } },
+      // From the opening eye nothing stands behind; three perches stood there, on the ground's middle rows.
+      { eye: opening, behind: [0.25, 0.5, 0.75].map((share) => ({ ...alongSight(camera, opening, width * share, 0.6 * D_SEE), h: 1 })) },
+    ];
+  });
+  for (const { eye, behind } of eyes) {
+    const view = viewAt(camera, eye);
+    const shownPerches = (behind ?? perches.filter(({ seat }) => seat).map(({ at: a }) => a)).filter((a) => {
+      const drawn = drawnAloft(view, a);
+      return drawn !== undefined && onScreen(view, drawn);
+    });
+    const middle = width / 2;
+    for (const kind of INSECT_KINDS) {
+      const ends = [
+        ...shownPerches.map((end) => ({ end, x: (middle + (drawnAloft(view, end)?.x ?? middle)) / 2, seat: true })),
+        ...(['left', 'right'] as const).map((side) => {
+          const span = SPANS[kind] * layout.insectSizes[kind];
+          const x = side === 'left' ? -span : width + span;
+          return { end: at(eye, x, OUT_AHEAD * D_SEE, awayDown(height, 1.3)), x: middle, seat: false };
+        }),
+      ];
+      for (const { end, x, seat } of ends) {
+        const start = { ...alongSight(camera, eye, x, D_SEE + PAST_BROW), h: 0 };
+        const { frames } = fly(
+          { camera, kind, size: layout.insectSizes[kind], butterfly: layout.insectSizes.butterfly, phase: 1.3, start, end, startSeat: false, endSeat: seat, eye: () => eye },
+          [{ name: 'edge', veer: (c) => ({ r: radiusOn(c, true), w: 0.1 * CLUMP_DISTANCE }) }],
+        );
+        const drawn = frames[0] ?? [];
+        const share = drawn.filter(({ shown }) => shown).length / drawn.length;
+        shares.push(share);
+        legs += 1;
+        if (share >= 0.95) full += 1;
+        if (seat && drawn.at(-1)?.shown) landed += 1;
+      }
+    }
+  }
+  const sorted = shares.toSorted((a, b) => a - b);
+  console.log(
+    `${screen.padEnd(20)} ${String(legs)} legs, drawn ≥ 95% of frames on ${String(full)}, ` +
+      `median ${((sorted[Math.floor(sorted.length / 2)] ?? 0) * 100).toFixed(1)}%, least ${((sorted[0] ?? 0) * 100).toFixed(1)}%, landed drawn ${String(landed)}`,
+  );
+}
diff --git a/docs/remove-before-merging/bite-12/ip3/bench.ts b/docs/remove-before-merging/bite-12/ip3/bench.ts
