index 00000000..8139b500
--- /dev/null
+++ b/docs/remove-before-merging/bite-12/ip3/veer.ts
@@ -0,0 +1,161 @@
+/**
+ * R3.1: legs past the eye, with and without the veer, per screen and kind.
+ * `node --import tsx veer.ts` from this directory; `SCREEN=` one screen's
+ * name, `SEEDS=` a comma list of visits, `LEGS=` legs per eye and kind.
+ */
+
+import { CLUMP_DISTANCE, type Eye, OPENING_EYE } from '../../../../src/pages/mushrooms/model/ground';
+import { INSECT_KINDS, type InsectKind } from '../../../../src/pages/mushrooms/model/insect-genes';
+import { mulberry32 } from '../../../../src/pages/mushrooms/model/random';
+import { STRIDE_CRUISE } from '../../../../src/pages/mushrooms/model/stride';
+import { onScreen, viewAt } from '../../../../src/pages/mushrooms/ui/scene/view';
+import { VIEWPORTS } from '../../../../src/pages/mushrooms/ui/scene/viewports';
+import { type Drawn, fly, SPANS, type Variant } from './legs';
+import { azimuthOf, drawnAloft, radiusOn, type Veer, veerAloft } from './proto';
+import { perchesOf, type PlanePerch } from './world';
+
+const CD = CLUMP_DISTANCE;
+const env = process.env;
+const SEEDS = (env['SEEDS'] ?? '1').split(',').map(Number);
+const LEGS = Number(env['LEGS'] ?? '3');
+const W = (env['W'] ?? '0.1,0.25').split(',').map(Number);
+
+const VARIANTS: Variant[] = [
+  { name: 'none' },
+  ...W.flatMap((w) => [
+    { name: `V_NEAR w${String(w)}`, veer: (camera) => ({ r: radiusOn(camera, false), w: w * CD }) },
+    { name: `edge w${String(w)}`, veer: (camera) => ({ r: radiusOn(camera, true), w: w * CD }) },
+  ] satisfies Variant[]),
+];
+
+/** What a run of legs adds up to, for one variant. */
+type Tally = { legs: number; zoom: number; px: number; near: [number, number, number]; big: number; jump: number; whips: number; pops: number; shown: number; frames: number };
+
+const fresh = (): Tally => ({ legs: 0, zoom: 0, px: 0, near: [0, 0, 0], big: 0, jump: 0, whips: 0, pops: 0, shown: 0, frames: 0 });
+
+function add(tally: Tally, frames: readonly Drawn[], width: number, height: number): void {
+  tally.legs += 1;
+  let [nearest, run, last, jump, popped] = [Infinity, 0, undefined as Drawn | undefined, 0, false];
+  const inside = (frame: Drawn) => frame.x >= 0 && frame.x <= width && frame.y >= 0 && frame.y <= height;
+  for (const frame of frames) {
+    nearest = Math.min(nearest, frame.d);
+    tally.frames += 1;
+    if (frame.shown) tally.shown += 1;
+    if (frame.shown && inside(frame)) {
+      tally.zoom = Math.max(tally.zoom, frame.zoom);
+      tally.px = Math.max(tally.px, frame.px);
+      if (last?.shown && inside(last)) jump = Math.max(jump, Math.hypot(frame.x - last.x, frame.y - last.y));
+    }
+    if (frame.popped && last?.shown && inside(last)) popped = true;
+    run = frame.shown && frame.px > width / 2 ? run + 1 : 0;
+    tally.big = Math.max(tally.big, run / 60);
+    last = frame;
+  }
+  tally.jump = Math.max(tally.jump, jump);
+  if (jump > width / 20) tally.whips += 1;
+  if (popped) tally.pops += 1;
+  [1, 0.5, 0.25].forEach((share, index) => {
+    if (nearest < share * CD) tally.near[index] = (tally.near[index] ?? 0) + 1;
+  });
+}
+
+const fmt = (tally: Tally) =>
+  `${String(tally.legs).padStart(4)} legs  zoom ${tally.zoom.toFixed(2)}  px ${tally.px.toFixed(0).padStart(5)}  ` +
+  `near<1/.5/.25 ${tally.near.map((n) => ((100 * n) / Math.max(1, tally.legs)).toFixed(1) + '%').join(' / ')}  ` +
+  `big ${tally.big.toFixed(2)} s  jump ${tally.jump.toFixed(0)} px  whips ${String(tally.whips)}  pops ${String(tally.pops)}  shown ${((100 * tally.shown) / Math.max(1, tally.frames)).toFixed(0)}%`;
+
+type Scenario = 'opening' | 'grid' | 'grid seat' | 'by a perch' | 'walk-in';
+
+const screens = VIEWPORTS.filter(([name]) => !env['SCREEN'] || name === env['SCREEN']);
+
+for (const [screen, width, height] of screens) {
+  const tallies = new Map<string, Tally>();
+  const tallyOf = (scenario: Scenario, kind: string, variant: string) => {
+    const key = `${scenario} | ${kind} | ${variant}`;
+    const found = tallies.get(key) ?? fresh();
+    tallies.set(key, found);
+    return found;
+  };
+  for (const seed of SEEDS) {
+    const random = mulberry32(seed * 977);
+    const { layout, perches } = perchesOf(seed, width, height);
+    const camera = layout.camera;
+    const seats = perches.filter(({ seat }) => seat);
+    const air = perches.filter(({ seat }) => !seat);
+    const someAir = Array.from({ length: 40 }, () => air[Math.floor(random() * air.length)]).filter((p) => p !== undefined);
+    const pool = [...seats, ...someAir];
+    const any = () => pool[Math.floor(random() * pool.length)] as PlanePerch;
+    const run = (scenario: Scenario, kind: InsectKind, from: PlanePerch, to: PlanePerch, eye: Eye) => {
+      if (from === to) return;
+      const { frames } = fly(
+        {
+          camera,
+          kind,
+          size: layout.insectSizes[kind],
+          butterfly: layout.insectSizes.butterfly,
+          phase: random() * Math.PI * 2,
+          start: from.at,
+          end: to.at,
+          startSeat: from.seat,
+          endSeat: to.seat,
+          eye: () => eye,
+        },
+        VARIANTS,
+      );
+      VARIANTS.forEach((variant, index) => add(tallyOf(scenario, kind, variant.name), frames[index] ?? [], width, height));
+    };
+    for (const kind of INSECT_KINDS) {
+      // The eye standing at the opening.
+      for (let leg = 0; leg < LEGS * 20; leg++) run('opening', kind, any(), any(), OPENING_EYE);
+      // Eyes on a grid among the perches, four headings each, with a leg to and from the nearest seat.
+      for (const x of [-6, -3, 0, 3, 6])
+        for (const y of [2, 5, 8, 11])
+          for (const heading of [0, Math.PI / 2, Math.PI, -Math.PI / 2]) {
+            const eye = { x, y, heading };
+            for (let leg = 0; leg < LEGS; leg++) run('grid', kind, any(), any(), eye);
+            const nearest = seats.toSorted((a, b) => Math.hypot(a.at.x - x, a.at.y - y) - Math.hypot(b.at.x - x, b.at.y - y))[0];
+            if (nearest) {
+              run('grid seat', kind, any(), nearest, eye);
+              run('grid seat', kind, nearest, any(), eye);
+            }
+          }
+      // Standing by a perch, facing it from the origin's side.
+      for (const by of seats.slice(0, 12))
+        for (const off of [0.3, 0.6]) {
+          const along = Math.hypot(by.at.x, by.at.y);
+          const s = 1 - (off * CD) / along;
+          const eye = { x: by.at.x * s, y: by.at.y * s, heading: azimuthOf({ x: 0, y: 0 }, by.at) };
+          for (let leg = 0; leg < LEGS; leg++) {
+            run('by a perch', kind, any(), by, eye);
+            run('by a perch', kind, by, any(), eye);
+          }
+        }
+    }
+    // Walking into a hovering insect: the eye walks from the opening at the stride's cruise
+    // through an air perch in front, a lateral offset off it, on to a clump's distance past.
+    const front = air.filter(({ at }) => Math.abs(at.x) < 4 && at.y < 11).slice(0, 6);
+    for (const kind of INSECT_KINDS)
+      for (const hover of front)
+        for (const off of [0, 0.1, 0.3]) {
+          const heading = azimuthOf({ x: 0, y: 0 }, hover.at);
+          const length = Math.hypot(hover.at.x, hover.at.y) + CD;
+          const side = { x: Math.cos(heading) * off * CD, y: -Math.sin(heading) * off * CD };
+          const span = SPANS[kind] * layout.insectSizes[kind];
+          VARIANTS.forEach((variant) => {
+            const frames: Drawn[] = [];
+            for (let t = 0; t <= length / STRIDE_CRUISE; t += 1 / 60) {
+              const eye = { x: side.x + Math.sin(heading) * STRIDE_CRUISE * t, y: side.y + Math.cos(heading) * STRIDE_CRUISE * t, heading };
+              const view = viewAt(camera, eye);
+              const veer: Veer | undefined = variant.veer?.(camera);
+              const aloft = veer ? veerAloft(eye, hover.at, veer) : hover.at;
+              const drawn = drawnAloft(view, aloft);
+              const shown = drawn !== undefined && onScreen(view, drawn, -span * drawn.zoom);
+              frames.push({ shown, zoom: drawn?.zoom ?? 0, px: span * (drawn?.zoom ?? 0), x: drawn?.x ?? Number.NaN, y: drawn?.y ?? Number.NaN, d: Math.hypot(aloft.x - eye.x, aloft.y - eye.y) });
+            }
+            add(tallyOf('walk-in', kind, variant.name), frames, width, height);
+          });
+        }
+  }
+  console.log(`\n== ${screen} (${String(width)}×${String(height)}), R_V edge ${(radiusOn(perchesOf(SEEDS[0] ?? 1, width, height).layout.camera, true) / CD).toFixed(3)} CD`);
+  for (const [key, tally] of tallies) console.log(`${key.padEnd(40)} ${fmt(tally)}`);
+}
