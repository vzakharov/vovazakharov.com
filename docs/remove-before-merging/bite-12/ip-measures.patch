index 00000000..bf655a46
--- /dev/null
+++ b/docs/remove-before-merging/bite-12/ip3/proto.ts
@@ -0,0 +1,155 @@
+/**
+ * Round 3's prototype of the leg's frame (`insect-plane.md` R2.1) and the
+ * veer (R3.1), against the real modules: an `Aloft` framed by the pinhole
+ * stood at the eye and turned to `c`, back again, and drawn through `viewOf`.
+ */
+
+import type { Point } from '../../../../src/pages/mushrooms/model/geometry';
+import {
+  bendAt,
+  type Camera,
+  CLUMP_DISTANCE,
+  type Eye,
+  EYE_HEIGHT,
+  pinholeOf,
+  SPREAD,
+  viewOf,
+} from '../../../../src/pages/mushrooms/model/ground';
+import {
+  buried,
+  type Placed,
+  sunkOver,
+  V_NEAR,
+  type View,
+} from '../../../../src/pages/mushrooms/ui/scene/view';
+
+/** A plane point and a height over it, in the clump's size. */
+export type Aloft = Point & { h: number };
+
+/** A point in a leg's frame, in CSS px, and its forward distance `q`. */
+export type Framed = Point & { q: number };
+
+/** The edge of the frame the ends keep inside, in gathered radians. */
+const EDGE = 0.9;
+/** The same, as plane azimuth off the frame's centre. */
+export const M = SPREAD * EDGE;
+
+/** `angle` wrapped into `[−π, π)`. */
+export function wrapped(angle: number): number {
+  return angle - 2 * Math.PI * Math.floor((angle + Math.PI) / (2 * Math.PI));
+}
+
+/** The plane azimuth of `point` from `eye`, from `+y` toward `+x`. */
+export function azimuthOf(eye: Point, point: Point): number {
+  return Math.atan2(point.x - eye.x, point.y - eye.y);
+}
+
+/** The frame's centre for a leg from `start` to `end` set off with `eye`: its heading, clamped so both ends lie within `M`. */
+export function centreOf(eye: Eye, start: Point, end: Point): number {
+  const a0 = azimuthOf(eye, start);
+  const a1 = a0 + wrapped(azimuthOf(eye, end) - a0);
+  const [lo, hi] = [Math.min(a0, a1), Math.max(a0, a1)];
+  const middle = (lo + hi) / 2;
+  const heading = middle + wrapped(eye.heading - middle);
+  return Math.min(Math.max(heading, hi - M), lo + M);
+}
+
+/** `aloft` in the frame centred on `c` stood at `eye`. */
+export function framedOf(
+  camera: Camera,
+  eye: Point,
+  c: number,
+  aloft: Aloft,
+): Framed {
+  const pin = pinholeOf(camera);
+  const theta = wrapped(azimuthOf(eye, aloft) - c) / SPREAD;
+  const d = Math.hypot(aloft.x - eye.x, aloft.y - eye.y);
+  const q = d * Math.cos(theta);
+  return {
+    x: pin.x + pin.focal * Math.tan(theta),
+    y: pin.y + ((EYE_HEIGHT - aloft.h) * pin.focal) / q,
+    q,
+  };
+}
+
+/** `framedOf` backwards, at forward distance `q`. */
+export function aloftOf(
+  camera: Camera,
+  eye: Point,
+  c: number,
+  point: Point,
+  q: number,
+): Aloft {
+  const pin = pinholeOf(camera);
+  const theta = Math.atan((point.x - pin.x) / pin.focal);
+  const azimuth = c + SPREAD * theta;
+  const d = q / Math.cos(theta);
+  return {
+    x: eye.x + d * Math.sin(azimuth),
+    y: eye.y + d * Math.cos(azimuth),
+    h: EYE_HEIGHT - ((point.y - pin.y) * q) / pin.focal,
+  };
+}
+
+/** The forward distance `flown` of the way from `q0` to `q1`, mixed straight in `1/q`. */
+export function mixQ(q0: number, q1: number, flown: number): number {
+  return 1 / ((1 - flown) / q0 + flown / q1);
+}
+
+/** How far along from `start` to `end` `point` stands, by its distance to each (`alongOf`). */
+export function alongOf(point: Point, start: Point, end: Point): number {
+  const gone = Math.hypot(point.x - start.x, point.y - start.y);
+  const left = Math.hypot(point.x - end.x, point.y - end.y);
+  return gone + left > 0 ? gone / (gone + left) : 1;
+}
+
+/** The veer's radius `R_V` and half-width `w`, in the clump's size. */
+export type Veer = { r: number; w: number };
+
+/** `d` pushed out to at least `r`, C¹-smooth over `[r − w, r + w]`. */
+export function veered(d: number, { r, w }: Veer): number {
+  if (d >= r + w) return d;
+  if (d <= r - w) return r;
+  return r + (d - r + w) ** 2 / (4 * w);
+}
+
+/** `aloft` pushed radially out from `eye` on the plane by `veered`, kept by `keep` (0 none of the push, 1 all of it). */
+export function veerAloft(
+  eye: Point,
+  aloft: Aloft,
+  veer: Veer,
+  keep = 1,
+): Aloft {
+  const d = Math.hypot(aloft.x - eye.x, aloft.y - eye.y);
+  const pushed = veered(d, veer);
+  if (pushed === d || d === 0) return aloft;
+  const scale = 1 + keep * (pushed / d - 1);
+  return {
+    x: eye.x + (aloft.x - eye.x) * scale,
+    y: eye.y + (aloft.y - eye.y) * scale,
+    h: aloft.h,
+  };
+}
+
+/** The veer's radius on `camera`: `V_NEAR`, or `V_NEAR` times the bend at the screen's edge. */
+export function radiusOn(camera: Camera, atEdge: boolean): number {
+  return atEdge ? V_NEAR * bendAt(pinholeOf(camera), 0) : V_NEAR;
+}
+
+/** Where `view` draws `aloft`, at zoom `CLUMP_DISTANCE / ahead`, sunk by the ground under it; `undefined` behind the eye or buried. */
+export function drawnAloft(
+  view: View,
+  aloft: Aloft,
+): (Point & { zoom: number }) | undefined {
+  const placedOf = (h: number): Placed => {
+    const viewed = viewOf(view, view.eye, aloft, h);
+    return {
+      ...viewed,
+      zoom: CLUMP_DISTANCE / viewed.ahead,
+      distance: Math.hypot(aloft.x - view.eye.x, aloft.y - view.eye.y),
+    };
+  };
+  const placed = sunkOver(view, placedOf(aloft.h), placedOf(0));
+  if (placed.ahead <= 0 || buried(view, placed)) return undefined;
+  return { x: placed.x, y: placed.y, zoom: placed.zoom };
+}
diff --git a/docs/remove-before-merging/bite-12/ip3/veer.ts b/docs/remove-before-merging/bite-12/ip3/veer.ts
