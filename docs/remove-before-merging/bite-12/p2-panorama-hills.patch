+  out: number,
+  to: number,
+  into: number,
+  s: number,
+): number {
+  const [s2, s3] = [s * s, s * s * s];
+  return (
+    (2 * s3 - 3 * s2 + 1) * from +
+    (s3 - 2 * s2 + s) * out +
