+// SCRATCH (A3): look at a shed; not committed.
+async function lookShed(
+  page: Page,
+  _controls: unknown,
+  _expect: Expect,
+  note: (line: string) => void,
+): Promise<void> {
+  const { Clouds } = await import('../scripts/lib/mushroom-probe.ts');
+  const { RAIN_MS } = await import('../src/pages/mushrooms/model/weather.ts');
+  const cloud = (await page.evaluate('__probe.clouds()', Clouds)).find(
+    (point) => point !== null,
+  );
+  if (!cloud) {
+    note('no cloud');
+    return;
+  }
+  const sprouts = async () =>
+    page.evaluate(
+      `(() => { const s = window.__game.scene.scenes[0]; return JSON.stringify(s.meadow.mushrooms.filter((m) => m.sprout).map((m) => { const b = s.bed.shown.get(m.id); return { id: m.id, parent: m.sprout.parent, at: m.sprout.at, x: b && Math.round(b.graphics.x), y: b && Math.round(b.graphics.y), vis: b && b.graphics.visible, sx: b && +b.graphics.scaleX.toFixed(3) }; })); })()`,
+      z.string(),
+    );
+  const arcs = async () =>
+    page.evaluate(
+      `(() => { const s = window.__game.scene.scenes[0]; return JSON.stringify({ t: s.time.now, tw: s.tweens.tweens.length, arcs: s.children.list.filter((c) => c.type === 'Arc' && c.depth >= 1e5).map((c) => [Math.round(c.x), Math.round(c.y), +c.radius.toFixed(1), c.visible, +c.alpha.toFixed(2), c.fillColor.toString(16)]) }); })()`,
+      z.string(),
+    );
+  await page.tap(cloud);
+  const stop = Math.ceil(RAIN_MS / FRAME_MS);
+  let at = 0;
+  const to = async (frame: number) => {
+    await page.step(frame - at);
+    at = frame;
+  };
+  await to(stop - 2);
+  const shown = async (label: string) => {
+    note(`${label}: ${await sprouts()}`);
+    note(`${label} arcs: ${await arcs()}`);
+    await page.shoot(`shed-${label}`);
+  };
+  // find the shed's frame
+  const before = await sprouts();
+  const seek = async (): Promise<void> => {
+    await to(at + 1);
+    if ((await sprouts()) !== before || at > stop + 600) return;
+    return seek();
+  };
+  await seek();
+  const shedAt = at;
+  note(`shed at frame ${String(shedAt)} (stop ${String(stop)})`);
+  for (const plus of [0, 3, 6, 12, 18, 24, 30, 36, 42, 46, 52, 70]) {
+    await to(shedAt + plus);
+    await shown(`p${String(plus).padStart(2, '0')}`);
+  }
+}
+
