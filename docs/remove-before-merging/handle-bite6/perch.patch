+import { VIEWPORTS, VISITS } from '../../../src/pages/mushrooms/ui/scene/viewports';
+import { opened, simulate } from './sim';
+const N = Number(process.env.N ?? 10);
+for (const [name, w, h] of VIEWPORTS) {
+  const out: string[] = [];
+  for (const with4 of [false, true]) {
+    let frames = 0, roam = 0, planted = 0;
+    for (const seed of VISITS.slice(0, N)) {
+      let last = 0;
+      simulate(opened(seed, w, h, false), seed, with4 ? ['butterfly', 'bee', 'butterfly', 'bee', 'butterfly', 'bee', 'butterfly'] : ['bee', 'bee', 'bee'], 5 * 60_000, 100, ({ meadow }) => {
+        for (const f of meadow.insects) if (f.kind === 'bee') { frames++; if (f.leg.to.kind === 'air') roam++; }
+        last = meadow.planted.length;
+      });
+      planted += last;
+    }
+    out.push(`${with4 ? 'with4' : 'alone'} roam ${(100 * roam / frames).toFixed(1)}% planted ${(planted / N).toFixed(1)}`);
+  }
+  console.log(name.padEnd(20), out.join(' | '));
+}
