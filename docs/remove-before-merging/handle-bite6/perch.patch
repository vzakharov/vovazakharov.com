+import { VIEWPORTS, VISITS } from '../../../src/pages/mushrooms/ui/scene/viewports';
+import { ALL_TEN, isAloft, opened, simulate, tapReach } from './sim';
+
+const N = Number(process.env.N ?? 20);
+const MIN = Number(process.env.MIN ?? 5);
+const only = process.env.ONLY;
+const seeds = VISITS.slice(0, N);
+const pct = (a: number, b: number) => (b ? ((100 * a) / b).toFixed(1) + '%' : '-');
+
+for (const [name, w, h] of VIEWPORTS) {
+  if (only && !name.includes(only)) continue;
+  // S1 + S4 + S5: all ten, opening clump.
+  let lostVisits = 0, lost = 0, frames = 0, bodyFrames = 0, wingFrames = 0;
+  const catchHit: Record<string, number> = { butterfly: 0, fly: 0, bee: 0 };
+  const catchAll: Record<string, number> = { butterfly: 0, fly: 0, bee: 0 };
+  for (const seed of seeds) {
+    const stand = opened(seed, w, h, false);
+    let visitLost = 0;
+    const hist: Array<Map<string, { x: number; y: number }>> = [];
+    simulate(stand, seed, ALL_TEN, MIN * 60_000, 50, ({ now, meadow, at, tracks, newLegs }) => {
+      for (const f of newLegs) if (f.leg.to.kind === 'away') visitLost++;
+      hist.push(new Map(at));
+      if (hist.length > 5) hist.shift();
+      frames++;
+      const flying = meadow.insects.filter((f) => isAloft(f, now));
+      let body = false, wing = false;
+      for (let i = 0; i < flying.length; i++) for (let j = i + 1; j < flying.length; j++) {
+        const a = flying[i]!, b = flying[j]!;
+        const pa = at.get(a.id)!, pb = at.get(b.id)!;
+        const ta = tracks.get(a.id)!, tb = tracks.get(b.id)!;
+        const d = Math.hypot(pa.x - pb.x, pa.y - pb.y);
+        if (d < (ta.body + tb.body) / 2) body = true;
+        if (d < (ta.span + tb.span) / 2) wing = true;
+      }
+      if (body) bodyFrames++;
+      if (wing) wingFrames++;
+      if (hist.length === 5) {
+        const past = hist[0]!;
+        for (const f of flying) {
+          const p = at.get(f.id)!, q = past.get(f.id);
+          if (!q) continue;
+          const t = tracks.get(f.id)!;
+          catchAll[f.kind]!++;
+          if (Math.hypot(p.x - q.x, p.y - q.y) <= tapReach(t.span / 2)) catchHit[f.kind]!++;
+        }
+      }
+    });
+    if (visitLost) lostVisits++;
+    lost += visitLost;
+  }
+  // S2: 4 butterflies + 3 bees, opening clump: bee roam share.
+  let beeFrames = 0, beeRoam = 0, planted = 0;
+  for (const seed of seeds) {
+    const stand = opened(seed, w, h, false);
+    let last = 0;
+    simulate(stand, seed, ['butterfly', 'bee', 'butterfly', 'bee', 'butterfly', 'bee', 'butterfly'], MIN * 60_000, 100, ({ meadow }) => {
+      for (const f of meadow.insects) if (f.kind === 'bee') { beeFrames++; if (f.leg.to.kind === 'air') beeRoam++; }
+      last = meadow.planted.length;
+    });
+    planted += last;
+  }
+  // S3: forest, 3 of 6 spotted: all ten; fly landings.
+  let flySeat = 0, flySpotted = 0, flyCap = 0;
+  let flyAloneSeat = 0, flyAloneSpotted = 0, flyAloneCap = 0;
+  for (const seed of seeds) {
+    const stand = opened(seed, w, h, true);
+    const spotted = new Set(stand.mushrooms.filter((m) => m.cap === 'spotted').map((m) => m.id));
+    simulate(stand, seed, ALL_TEN, MIN * 60_000, 100, ({ newLegs }) => {
+      for (const f of newLegs) if (f.kind === 'fly' && (f.leg.to.kind === 'cap' || f.leg.to.kind === 'flower')) {
+        flySeat++;
+        if (f.leg.to.kind === 'cap') { flyCap++; if (spotted.has(f.leg.to.id)) flySpotted++; }
+      }
+    });
+    simulate(stand, seed, ['fly', 'fly', 'fly'], MIN * 60_000, 100, ({ newLegs }) => {
+      for (const f of newLegs) if (f.kind === 'fly' && (f.leg.to.kind === 'cap' || f.leg.to.kind === 'flower')) {
+        flyAloneSeat++;
+        if (f.leg.to.kind === 'cap') { flyAloneCap++; if (spotted.has(f.leg.to.id)) flyAloneSpotted++; }
+      }
+    });
+  }
+  console.log(
+    `${name.padEnd(20)} lost ${lostVisits}/${seeds.length} (${lost}) | body ${pct(bodyFrames, frames)} wing ${pct(wingFrames, frames)} | catch b ${pct(catchHit.butterfly!, catchAll.butterfly!)} f ${pct(catchHit.fly!, catchAll.fly!)} e ${pct(catchHit.bee!, catchAll.bee!)} | beeRoam ${pct(beeRoam, beeFrames)} planted ${(planted / seeds.length).toFixed(2)} | flySpotted all10 ${pct(flySpotted, flySeat)} (caps ${pct(flySpotted, flyCap)}) alone ${pct(flyAloneSpotted, flyAloneSeat)} (caps ${pct(flyAloneSpotted, flyAloneCap)})`,
+  );
+}
