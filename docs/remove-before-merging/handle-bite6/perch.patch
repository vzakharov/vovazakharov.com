+import type { Point } from '../../../src/pages/mushrooms/model/geometry';
+import { insectGenes, type InsectKind } from '../../../src/pages/mushrooms/model/insect-genes';
+import { carriedFrom } from '../../../src/pages/mushrooms/model/insect-motion';
+import { wingspan } from '../../../src/pages/mushrooms/model/insect-outline';
+import { type Carried, flightPoint } from '../../../src/pages/mushrooms/model/insect-paths';
+import type { Flier } from '../../../src/pages/mushrooms/model/insects';
+import { phaseOf } from '../../../src/pages/mushrooms/model/motion';
+import { CAP_KINDS } from '../../../src/pages/mushrooms/model/mushroom-genes';
+import { mulberry32, nextSeed } from '../../../src/pages/mushrooms/model/random';
+import { standingFlowers } from '../../../src/pages/mushrooms/ui/scene/flower-plots';
+import { flowerLift, sightingOf, type Stand } from '../../../src/pages/mushrooms/ui/scene/flower-sight';
+import { meadowLayout } from '../../../src/pages/mushrooms/ui/scene/layout';
+import { airSpots, perchSight, perchSpot, seatAt } from '../../../src/pages/mushrooms/ui/scene/perch-sight';
+import { tapReach } from '../../../src/pages/mushrooms/ui/scene/sky-layout';
+
+export function opened(seed: number, width: number, height: number, forest: boolean): Stand & { meadow: Meadow } {
+  const random = mulberry32(seed);
+  let meadow = firstMeadow(random);
+  const flowers = firstFlowers(random, 7);
+  const layout = meadowLayout(width, height, seed ^ 0xf1_0e_25);
+  const growing = mulberry32(seed ^ 0x9e_0a);
+  const grown = forest ? layout.mushrooms.length - meadow.mushrooms.length : 0;
+  for (const index of Array.from({ length: grown }).keys()) {
+    const cap = CAP_KINDS[index % CAP_KINDS.length] ?? 'spotted';
+    meadow = reduce(meadow, { kind: 'grow', cap, seed: nextSeed(growing) });
+  }
