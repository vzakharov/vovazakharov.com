+import { VIEWPORTS, VISITS } from '../../../src/pages/mushrooms/ui/scene/viewports';
+import { ALL_TEN, opened, simulate } from './sim';
+const N = Number(process.env.N ?? 10);
+for (const [name, w, h] of VIEWPORTS) {
+  const r: string[] = [];
+  for (const rel of [ALL_TEN, ['fly', 'fly', 'fly'] as const]) {
+    let seat = 0, sp = 0, cap = 0, resettle = 0;
+    for (const seed of VISITS.slice(0, N)) {
+      const stand = opened(seed, w, h, true);
+      const spotted = new Set(stand.mushrooms.filter((m) => m.cap === 'spotted').map((m) => m.id));
+      simulate(stand, seed, rel, 5 * 60_000, 100, ({ newLegs }) => {
+        for (const f of newLegs) if (f.kind === 'fly' && (f.leg.to.kind === 'cap' || f.leg.to.kind === 'flower')) {
+          seat++; if (JSON.stringify(f.leg.to) === JSON.stringify(f.leg.from)) resettle++;
+          if (f.leg.to.kind === 'cap') { cap++; if (spotted.has(f.leg.to.id)) sp++; }
+        }
+      });
+    }
+    r.push(`${rel.length === 3 ? 'alone' : 'all10'} spotted ${(100 * sp / seat).toFixed(1)}% caps ${(100 * sp / cap).toFixed(1)}% resettle ${(100 * resettle / seat).toFixed(0)}%`);
+  }
+  console.log(name.padEnd(20), r.join(' | '));
+}
