@@ -0,0 +1,30 @@
+import { VIEWPORTS, VISITS } from '../../../src/pages/mushrooms/ui/scene/viewports';
+import { ALL_TEN, isAloft, opened, simulate, tapReach } from './sim';
+const N = Number(process.env.N ?? 6);
+for (const [name, w, h] of VIEWPORTS) {
+  const hit: Record<string, number> = { butterfly: 0, fly: 0, bee: 0 }, all: Record<string, number> = { butterfly: 0, fly: 0, bee: 0 };
+  let frames = 0, body = 0, lost = 0;
+  for (const seed of VISITS.slice(0, N)) {
+    const hist: Array<Map<string, { x: number; y: number }>> = [];
+    simulate(opened(seed, w, h, false), seed, ALL_TEN, 3 * 60_000, 50, ({ now, meadow, at, tracks, newLegs }) => {
+      for (const f of newLegs) if (f.leg.to.kind === 'away') lost++;
+      hist.push(new Map(at)); if (hist.length > 5) hist.shift();
+      const flying = meadow.insects.filter((f) => isAloft(f, now));
+      const inAir = meadow.insects.filter((f) => isAloft(f, now) || f.leg.to.kind === 'air');
+      frames++;
+      let o = false;
+      for (let i = 0; i < inAir.length; i++) for (let j = i + 1; j < inAir.length; j++) {
+        const a = inAir[i]!, b = inAir[j]!; if (!isAloft(a, now) && !isAloft(b, now) && !process.env.BOTH) {} const pa = at.get(a.id)!, pb = at.get(b.id)!;
+        if (Math.hypot(pa.x - pb.x, pa.y - pb.y) < (tracks.get(a.id)!.body + tracks.get(b.id)!.body) / 2) o = true;
+      }
+      if (o) body++;
+      if (hist.length < 5) return;
+      for (const f of flying) {
+        const p = at.get(f.id)!, q = hist[0]!.get(f.id); if (!q) continue;
+        all[f.kind]!++; if (Math.hypot(p.x - q.x, p.y - q.y) <= tapReach(tracks.get(f.id)!.span / 2)) hit[f.kind]!++;
+      }
+    });
+  }
+  const p = (k: string) => (100 * hit[k]! / all[k]!).toFixed(0);
+  console.log(name.padEnd(20), `pace ${process.env.PACE ?? 'own'} catch b ${p('butterfly')} f ${p('fly')} e ${p('bee')} body ${(100 * body / frames).toFixed(1)} lost ${lost}`);
+}
