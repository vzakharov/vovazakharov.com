+import { ALL_TEN, isAloft, opened, simulate } from './sim';
+import { VISITS } from '../../../src/pages/mushrooms/ui/scene/viewports';
+const [w, h] = [Number(process.env.W ?? 320), Number(process.env.H ?? 568)];
+let frames = 0, any = 0, mm = 0, mh = 0, hh = 0, inAirSum = 0, crowdedHover = 0;
+for (const seed of VISITS.slice(0, Number(process.env.N ?? 8))) {
+  simulate(opened(seed, w, h, false), seed, ALL_TEN, 3 * 60_000, 50, ({ now, meadow, at, tracks }) => {
+    if (now < 5000) return;
+    frames++;
+    const air = meadow.insects.filter((f) => isAloft(f, now) && f.leg.to.kind !== "away" && (process.env.HOVER ? true : true));
+    inAirSum += air.length;
+    let a1 = false, b1 = false, c1 = false, d1 = false;
+    for (let i = 0; i < air.length; i++) for (let j = i + 1; j < air.length; j++) {
+      const a = air[i]!, b = air[j]!; const pa = at.get(a.id)!, pb = at.get(b.id)!;
+      if (Math.hypot(pa.x - pb.x, pa.y - pb.y) >= (tracks.get(a.id)!.body + tracks.get(b.id)!.body) / 2) continue;
+      a1 = true;
+      const ma = isAloft(a, now), mb = isAloft(b, now);
+      if (ma && mb) b1 = true; else if (ma || mb) c1 = true; else d1 = true;
+    }
+    if (a1) any++; if (b1) mm++; if (c1) mh++; if (d1) hh++;
+  });
+}
+const p = (x: number) => (100 * x / frames).toFixed(1);
+console.log('any', p(any), 'move-move', p(mm), 'move-hover', p(mh), 'hover-hover', p(hh), 'avg in air', (inAirSum / frames).toFixed(2));
