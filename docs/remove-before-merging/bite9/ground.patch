+/** The shape genes a cap's drawn width turns on, besides its own. */
+const CAP_TURNS = [
+  'capHeight',
+  'domePower',
+  'capTilt',
+  'lean',
+  'stemBend',
+] as const;
+
+/**
+ * The narrowest a cap stood with `splay` is drawn across, cap and gills, per
+ * unit of its size: each species at its narrowest `capWidth`, each gene it
+ * turns on (`CAP_TURNS`) at either bound, and at none where its range spans
+ * none, since a stand turns the cap by its size alone (`splayed`). Turned, a
+ * cap draws narrower than its gene, and its rim's rounding narrower still.
+ */
+const onCanvas = toCanvas(1);
+
+function narrowestCap(splay: number): number {
+  return Math.min(
+    ...MUSHROOM_SPECIES.flatMap((species) => {
+      const ranges = GENE_RANGES[species];
+      const corners = CAP_TURNS.reduce<MushroomGenes[]>(
+        (grown, gene) => {
+          const [least, most] = ranges[gene];
+          const bounds =
+            least < 0 && most > 0 ? [least, 0, most] : [least, most];
+          return grown.flatMap((genes) =>
+            bounds.map((bound) => ({ ...genes, [gene]: bound })),
+          );
+        },
+        [
+          {
+            ...mushroomGenes({ seed: 0, species }),
+            capWidth: ranges.capWidth[0],
+          },
+        ],
+      );
+      return corners.map((corner) => {
+        const { genes, turn } = splayed(corner, splay);
+        const { left, right } = boxAround(
+          capOutlines(genes)
+            .flat()
+            .map((point) => placedAt({ x: 0, y: 0 }, turn, onCanvas(point))),
+        );
+        return right - left;
+      });
+    }),
+  );
+}
